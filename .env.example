# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# MUST be a free model. config.assert_free_model refuses paid slugs at startup.
# `:free` suffix = always free. `openrouter/free` = router that picks a free model.
AVA_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Local timezone for reminders. Naive times you give AVA are read in this zone.
AVA_TZ=Asia/Dhaka
